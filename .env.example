# ─────────────────────────────────────────────────────────────────
#  DDC — Environment variable reference
#  Copy this file to .env (never commit .env)
#  All values are required unless marked [optional]
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development                 # development | staging | production
PORT=4000
API_BASE_URL=http://localhost:4000   # full base for self-referencing links (webhooks, etc.)

# ── MongoDB Atlas ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ddc_dev?retryWrites=true&w=majority

# ── Redis (Upstash or local) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379     # Upstash: rediss://:<token>@<host>:<port>

# ── JWT ───────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-32-chars-minimum
JWT_REFRESH_SECRET=change-me-32-chars-minimum-different
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Cookies ───────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost              # production: .desiredrycleaning.in
COOKIE_SECURE=false                  # production: true

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# ── Google OAuth 2.0 ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ── SMS — MSG91 ───────────────────────────────────────────────────
# SMS is a CORE dependency (login OTPs). DLT approval required in India.
SMS_PROVIDER=mock                    # mock | msg91
SMS_API_KEY=
SMS_SENDER_ID=DESIRD                 # DLT-approved sender ID
SMS_OTP_TEMPLATE_ID=                 # DLT-approved template ID

# ── Payments ──────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock                # mock | razorpay | cashfree
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Cashfree (alternative)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# ── Cloudinary ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Maps ───────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=                 # Server-side key (IP-restricted in prod)

# ── Email ─────────────────────────────────────────────────────────
EMAIL_PROVIDER=mock                  # mock | resend | postmark | sendgrid
EMAIL_API_KEY=
EMAIL_FROM=noreply@desiredrycleaning.in

# ── Web Push (VAPID) ─────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:techfied.desiredrycleaning@gmail.com

# ── Sentry ────────────────────────────────────────────────────────
SENTRY_DSN=                          # [optional]

# ── Frontend env vars (prefix VITE_) ─────────────────────────────
# Copied into each apps/web-*/  .env  file
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_GOOGLE_MAPS_KEY=               # Browser key (HTTP referrer restricted in prod)
VITE_VAPID_PUBLIC_KEY=
VITE_SENTRY_DSN=                    # [optional]
