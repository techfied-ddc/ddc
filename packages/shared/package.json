{
  "name": "@ddc/shared",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build":      "tsc -p tsconfig.build.json",
    "typecheck":  "tsc --noEmit",
    "test":       "vitest run",
    "lint":       "eslint src --ext .ts",
    "clean":      "rimraf dist"
  },
  "devDependencies": {
    "@ddc/config": "workspace:*",
    "rimraf":      "^6.0.1",
    "typescript":  "^5.7.3",
    "vitest":      "^3.0.5"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
