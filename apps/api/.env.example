# apps/api — copy to .env and fill in
# See root .env.example for full documentation of every variable.
# Production values → set as Railway environment variables (Variables tab).

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ddc_dev?retryWrites=true&w=majority

# Redis (Upstash for prod, local for dev)
REDIS_URL=redis://localhost:6379

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-32-chars-minimum
JWT_REFRESH_SECRET=change-me-32-chars-minimum-different
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# SMS — deprecated in favour of email OTP; kept for reference only
# SMS_PROVIDER=mock
# SMS_API_KEY=
# SMS_SENDER_ID=DESIRD
# SMS_OTP_TEMPLATE_ID=

# Email OTP (Resend — free, no card needed)
# Get key at: https://resend.com → API Keys
RESEND_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@desiredrycleaning.in

# Payments — UPI link mode (default, no gateway account needed)
PAYMENT_PROVIDER=upi_link
# Your UPI VPA (e.g. business@paytm or desiredrycleaning@hdfc) for UPI link payments
UPI_VPA=
UPI_DISPLAY_NAME=Desire Dry Cleaning

# Razorpay (optional — switch PAYMENT_PROVIDER=razorpay to enable)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree (optional — switch PAYMENT_PROVIDER=cashfree to enable)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Geocoding (OpenCage — free tier, 2500 req/day, no billing card)
# Get key at: https://opencagedata.com
# Optional: routing falls back to pincode-only matching if not set.
OPENCAGE_API_KEY=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:techfied.desiredrycleaning@gmail.com

# Sentry [optional]
SENTRY_DSN=
