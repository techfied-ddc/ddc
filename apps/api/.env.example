# apps/api — copy to .env and fill in
# See root .env.example for full documentation of every variable.
# Production values → set as Render environment variables.

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ddc_dev?retryWrites=true&w=majority

# Redis (Upstash for prod, local for dev)
REDIS_URL=redis://localhost:6379

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-32-chars-minimum
JWT_REFRESH_SECRET=change-me-32-chars-minimum-different
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# SMS (MSG91) — mock mode in dev: OTPs logged to console
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=DESIRD
SMS_OTP_TEMPLATE_ID=

# Payments — mock mode in dev: all payments succeed automatically
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (server key, IP-restricted in prod)
GOOGLE_MAPS_API_KEY=

# Email — mock mode in dev: emails logged to console
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=noreply@desiredrycleaning.in

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:techfied.desiredrycleaning@gmail.com

# Sentry [optional]
SENTRY_DSN=
