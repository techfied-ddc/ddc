{
  "name": "@ddc/api",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev":       "tsx watch src/index.ts",
    "build":     "tsc -p tsconfig.json",
    "start":     "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint":      "eslint src --ext .ts",
    "test":      "vitest run",
    "test:watch":"vitest",
    "seed":      "tsx src/db/seed/seed.ts",
    "clean":     "rimraf dist"
  },
  "dependencies": {
    "@ddc/shared":           "workspace:*",
    "@bull-board/api":       "^6.4.1",
    "@bull-board/express":   "^6.4.1",
    "argon2":                "^0.41.1",
    "bcryptjs":              "^2.4.3",
    "bullmq":                "^5.23.0",
    "@googlemaps/google-maps-services-js": "^3.3.42",
    "cloudinary":            "^2.5.1",
    "cookie-parser":         "^1.4.7",
    "cors":                  "^2.8.5",
    "express":               "^4.21.2",
    "express-rate-limit":    "^7.5.0",
    "googleapis":            "^144.0.0",
    "helmet":                "^8.0.0",
    "ioredis":               "^5.4.2",
    "jsonwebtoken":          "^9.0.2",
    "mongoose":              "^8.8.3",
    "multer":                "^1.4.5-lts.1",
    "nanoid":                "^3.3.8",
    "pdfkit":                "^0.15.1",
    "pino":                  "^9.6.0",
    "pino-http":             "^10.4.0",
    "pino-pretty":           "^13.0.0",
    "socket.io":             "^4.8.1",
    "web-push":              "^3.6.7",
    "zod":                   "^3.24.1"
  },
  "devDependencies": {
    "@ddc/config":     "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors":     "^2.8.17",
    "@types/express":  "^4.17.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer":   "^1.4.12",
    "@types/node":     "^22.9.0",
    "@types/pdfkit":   "^0.13.9",
    "rimraf":          "^6.0.1",
    "supertest":       "^7.0.0",
    "@types/supertest":"^6.0.2",
    "@types/web-push": "^3.6.4",
    "tsx":             "^4.19.2",
    "typescript":      "^5.7.2",
    "vitest":          "^2.1.8"
  }
}
