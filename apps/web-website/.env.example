# apps/web-website — copy to .env and fill in
# Production values → set as Vercel environment variables

# API base URL (no trailing slash)
VITE_API_URL=http://localhost:4000
# Production: https://api.desiredrycleaning.in

# Google Maps (browser key, HTTP-referrer restricted in prod to desiredrycleaning.in/*)
VITE_GOOGLE_MAPS_KEY=
