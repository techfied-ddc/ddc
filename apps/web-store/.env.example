# apps/web-store — copy to .env and fill in
# Production values → set as Vercel environment variables

# API base URL (no trailing slash)
VITE_API_URL=http://localhost:4000
# Production: https://api.desiredrycleaning.in

# Socket.IO server URL
VITE_SOCKET_URL=http://localhost:4000
# Production: https://api.desiredrycleaning.in

# VAPID public key — generate with: npx web-push generate-vapid-keys
# Must match VAPID_PUBLIC_KEY in the API
VITE_VAPID_PUBLIC_KEY=

# Google Maps (browser key, HTTP-referrer restricted in prod)
VITE_GOOGLE_MAPS_KEY=

# Sentry DSN [optional]
VITE_SENTRY_DSN=
